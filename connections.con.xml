<?xml version="1.0" encoding="UTF-8"?>
<connections>
    <!-- 
        PERBAIKAN LAJUR:
        Berdasarkan feedback visual, Lajur 0 adalah lajur paling KIRI (trotoar).
        - Lajur 0: Belok Kiri (Slip Road)
        - Lajur 1: Lurus
        - Lajur 2: Lurus & Belok Kanan
    -->

    <!-- === UTARA === -->
    <!-- Split -->
    <connection from="north_in_1" to="slip_ne"     fromLane="0" toLane="0" uncontrolled="true"/>
    <connection from="north_in_1" to="north_in_2"  fromLane="1" toLane="0"/>
    <connection from="north_in_1" to="north_in_2"  fromLane="2" toLane="1"/>
    <!-- Merge -->
    <connection from="north_out_1" to="north_out_2" fromLane="0" toLane="1"/>
    <connection from="north_out_1" to="north_out_2" fromLane="1" toLane="2"/>
    <connection from="slip_wn"     to="north_out_2" fromLane="0" toLane="0" uncontrolled="true"/>

    <!-- === SELATAN === -->
    <!-- Split -->
    <connection from="south_in_1" to="slip_sw"     fromLane="0" toLane="0" uncontrolled="true"/>
    <connection from="south_in_1" to="south_in_2"  fromLane="1" toLane="0"/>
    <connection from="south_in_1" to="south_in_2"  fromLane="2" toLane="1"/>
    <!-- Merge -->
    <connection from="south_out_1" to="south_out_2" fromLane="0" toLane="1"/>
    <connection from="south_out_1" to="south_out_2" fromLane="1" toLane="2"/>
    <connection from="slip_es"     to="south_out_2" fromLane="0" toLane="0" uncontrolled="true"/>

    <!-- === TIMUR === -->
    <!-- Split -->
    <connection from="east_in_1" to="slip_es"     fromLane="0" toLane="0" uncontrolled="true"/>
    <connection from="east_in_1" to="east_in_2"  fromLane="1" toLane="0"/>
    <connection from="east_in_1" to="east_in_2"  fromLane="2" toLane="1"/>
    <!-- Merge -->
    <connection from="east_out_1" to="east_out_2" fromLane="0" toLane="1"/>
    <connection from="east_out_1" to="east_out_2" fromLane="1" toLane="2"/>
    <connection from="slip_ne"     to="east_out_2" fromLane="0" toLane="0" uncontrolled="true"/>

    <!-- === BARAT === -->
    <!-- Split -->
    <connection from="west_in_1" to="slip_wn"     fromLane="0" toLane="0" uncontrolled="true"/>
    <connection from="west_in_1" to="west_in_2"  fromLane="1" toLane="0"/>
    <connection from="west_in_1" to="west_in_2"  fromLane="2" toLane="1"/>
    <!-- Merge -->
    <connection from="west_out_1" to="west_out_2" fromLane="0" toLane="1"/>
    <connection from="west_out_1" to="west_out_2" fromLane="1" toLane="2"/>
    <connection from="slip_sw"     to="west_out_2" fromLane="0" toLane="0" uncontrolled="true"/>

    <!-- === CENTER (Lampu Merah: Lurus & Kanan) === -->
    <!-- Utara -->
    <connection from="north_in_2" to="south_out_1" fromLane="0" toLane="0"/>
    <connection from="north_in_2" to="south_out_1" fromLane="1" toLane="1"/>
    <connection from="north_in_2" to="west_out_1"  fromLane="1" toLane="1"/> <!-- Kanan dari lajur median -->

    <!-- Selatan -->
    <connection from="south_in_2" to="north_out_1" fromLane="0" toLane="0"/>
    <connection from="south_in_2" to="north_out_1" fromLane="1" toLane="1"/>
    <connection from="south_in_2" to="east_out_1"  fromLane="1" toLane="1"/>

    <!-- Timur -->
    <connection from="east_in_2"  to="west_out_1"  fromLane="0" toLane="0"/>
    <connection from="east_in_2"  to="west_out_1"  fromLane="1" toLane="1"/>
    <connection from="east_in_2"  to="north_out_1" fromLane="1" toLane="1"/>

    <!-- Barat -->
    <connection from="west_in_2"  to="east_out_1"  fromLane="0" toLane="0"/>
    <connection from="west_in_2"  to="east_out_1"  fromLane="1" toLane="1"/>
    <connection from="west_in_2"  to="south_out_1" fromLane="1" toLane="1"/>
</connections>
