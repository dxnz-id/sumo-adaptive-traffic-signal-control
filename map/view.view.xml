<?xml version="1.0" encoding="UTF-8"?>
<viewsettings>
    <scheme name="real world">
        <background backgroundColor="255,255,255" showGrid="0"/>
        <edges laneShowBorders="1" showLinkDecals="1"
               edgeParam="" vehicleParam="" vehicleScaleParam=""
               edgeData="" vehicleData="" vehicleScaleData="">
            <colorScheme name="by selection">
                <entry color="0,192,0" name="selected"/>
                <entry color="30,50,70"/>
            </colorScheme>
        </edges>
        <vehicles vehicleQuality="2" showBlinker="1" drawMinGap="0"
                  minVehicleSize="2.0" vehicleExaggeration="1.5">
            <colorScheme name="by speed">
                <entry color="255,0,0"   threshold="0"/>
                <entry color="255,200,0" threshold="7"/>
                <entry color="0,220,0"   threshold="14"/>
            </colorScheme>
        </vehicles>
        <junctions drawShape="1" drawCrossingsAndWalkingareas="1"
                   junctionExaggeration="1.0"/>
        <legend showSizeLegend="1" showColorLegend="0"/>
        <pois poiType_show="1" poiType_size="40.00" poiType_color="0,0,0" poiName_show="0" poiName_size="40.00" poiName_color="0,0,0" />
    </scheme>
</viewsettings>
